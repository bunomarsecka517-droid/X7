# Blockchain RPC Endpoints (Free tiers recommended for Railway)
MAINNET_RPC=https://eth-mainnet.alchemyapi.io/v2/YOUR_KEY
POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
OPTIMISM_RPC=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_RPC=https://bsc-mainnet.g.alchemy.com/v2/YOUR_KEY

# Gas Sponsorship - Pimlico (FREE TIER)
PIMLICO_API_KEY=YOUR_KEY
PIMLICO_ENDPOINT_ID=YOUR_ENDPOINT

# Payment Settlement - Modem Pay
MODEM_PAY_API_KEY=YOUR_KEY
MODEM_PAY_SECRET=YOUR_SECRET
MODEM_PAY_DESTINATION=your_email_or_account_id

# MEV / Private Execution (Optional - Flashbots requires key)
FLASHBOTS_RELAY_SIGNING_KEY=OPTIONAL
MEV_BLOCKER_API_KEY=OPTIONAL
TAICHI_API_KEY=OPTIONAL

# Treasury Configuration (Generated Automatically)
TREASURY_ADDRESS=0x4e59b44847b379578588920eA3601C0C915B1B8A
TREASURY_SIGNER_PRIVATE_KEY=YOUR_PRIVATE_KEY_SECURE_VAULT

# Deployment & Runtime
DEPLOYMENT_ENV=production
ALERT_EMAIL=your@email.com
LOG_LEVEL=info
NODE_ENV=production
PORT=3000
